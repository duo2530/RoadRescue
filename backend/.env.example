# 道路救援后端本地密钥模板：复制为 backend/.env 后填写（.env 不入库）
# 微信小程序（真机登录需要；H5 演示可留空）
APP_ID=
APP_SECRET=
# 微信支付 v3
WX_PAY_MCH_ID=
WX_PAY_SERIAL_NO=
WX_PAY_API_V3_KEY=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_PUBLIC_KEY_PATH=
WX_PAY_PUBLIC_KEY_ID=
# 支付宝 H5 沙箱（私钥和支付宝公钥为单行 PKCS8/Base64）
ALIPAY_SANDBOX_ENABLED=false
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_SELLER_ID=
# 本地开发可留空，通过回跳后的服务端主动查询确认；部署后填公网 HTTPS 通知地址。
ALIPAY_NOTIFY_URL=
ALIPAY_H5_RETURN_URL=http://localhost:9090/#/pages/order/detail
ALIPAY_ALLOWED_RETURN_ORIGINS=http://localhost:9090,http://127.0.0.1:9090
# 腾讯云（COS / OCR / 人脸）与腾讯位置服务
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_MAP_KEY=
